{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start 55GMS",
      "type": "process",
      "command": "node",
      "args": ["."],
      "options": {
        "env": {
          "PORT": "8080"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "URL: http://localhost:8080"
        }
      }
    }
  ]
}